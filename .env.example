# Copy to .env (repository root) for local development. Never commit .env.
# In production, set these as real environment variables (see README.md, "Configuration").
# Generate secrets with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"

# --- Django -------------------------------------------------------------------
# DJANGO_SETTINGS_MODULE cannot be set here (this file is read by the settings
# themselves). manage.py defaults to config.settings.local; export it for
# Celery/Gunicorn:  export DJANGO_SETTINGS_MODULE=config.settings.local
# Required in production: >= 50 random characters.
# DJANGO_SECRET_KEY=
# Required in production: >= 50 random characters, different from DJANGO_SECRET_KEY.
# JWT_SIGNING_KEY=
# Required in production: comma-separated host names, no "*".
# DJANGO_ALLOWED_HOSTS=
# DJANGO_CSRF_TRUSTED_ORIGINS=
# CORS_ALLOWED_ORIGINS=

# --- Database (required in production) ----------------------------------------
# Local default matches docker-compose.yml.
DATABASE_URL=postgres://dewmix:dewmix@localhost:5432/dewmix
DATABASE_CONN_MAX_AGE=60

# --- Redis / Celery -----------------------------------------------------------
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
# Cache used for API rate limiting. Unset = per-process memory (fine locally,
# not across multiple Gunicorn workers).
REDIS_CACHE_URL=redis://localhost:6379/0
THROTTLE_RATE_AUTH=10/min

# --- Observability ------------------------------------------------------------
LOG_LEVEL=INFO
# json (production) or console (readable; local default)
LOG_FORMAT=console
# Bearer token for scraping /metrics. Unset = /metrics disabled (unless DEBUG).
# METRICS_TOKEN=
# SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1
# RELEASE_VERSION=

# --- HTTPS (production) -------------------------------------------------------
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000

# --- Object storage (Stage 2) -------------------------------------------------
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_ENDPOINT_URL=
# AWS_S3_CUSTOM_DOMAIN=

# --- AI providers (Stage 8; not used by any code yet) --------------------------
# ACTIVE_AI_PROVIDER=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# LOCAL_LLM_URL=
