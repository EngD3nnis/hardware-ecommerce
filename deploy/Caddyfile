# HTTPS certificates are obtained automatically for SITE_DOMAIN.
{$SITE_DOMAIN} {
	encode gzip
	handle_path /static/* {
		root * /srv/static
		file_server
	}
	handle_path /media/* {
		root * /srv/media
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	# /metrics is scraped from inside the network only.
	respond /metrics 404
	reverse_proxy web:8000 {
		header_up X-Request-ID {http.request.uuid}
	}
}
